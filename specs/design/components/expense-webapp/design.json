{
  "name": "expense-webapp",
  "type": "web-application",
  "version": "0.1.0",
  "language": "TypeScript",
  "buildpack": "docker",
  "appPath": "expense-webapp",
  "entrypoint": "deployment/web-application",
  "exposure": "internet",
  "stories": [
    "F1.1",
    "F1.2",
    "F1.3",
    "F1.4",
    "F1.5",
    "F1.6",
    "F1.7",
    "F2.1",
    "F2.2",
    "F2.3",
    "F2.4",
    "F3.1",
    "F3.2",
    "F4.1",
    "F4.2"
  ],
  "description": "The single-page app every actor uses: employees submit and track claims, managers review and decide on their team's claims, and finance exports approved claims to payroll. Role-gated screens sharing one shell. Does not store claim data itself — all of it lives behind expense-api.",
  "dependencies": [
    {
      "kind": "component",
      "name": "expense-api",
      "description": "Claims, approvals, team queues and payroll export data.",
      "wiring": {
        "endpoint": {
          "component": "employees-submit-expenseqwe-expense-api",
          "name": "http",
          "visibility": "project",
          "envBindings": {
            "address": "EXPENSE_API_URL"
          }
        }
      }
    },
    {
      "kind": "component",
      "name": "receipt-agent",
      "description": "Reads an uploaded receipt and pre-fills the claim form.",
      "wiring": {
        "endpoint": {
          "component": "employees-submit-expenseqwe-receipt-agent",
          "name": "http",
          "visibility": "project",
          "envBindings": {
            "address": "RECEIPT_AGENT_URL"
          }
        }
      }
    },
    {
      "kind": "platform-resource",
      "name": "thunder-auth",
      "description": "Sign-in for employees, managers and finance.",
      "resourceType": "thunder-app",
      "wiring": {
        "ref": "employees-submit-98a6d041",
        "envBindings": {
          "client_id": "THUNDER_AUTH_CLIENT_ID",
          "issuer": "THUNDER_AUTH_ISSUER",
          "jwks_url": "THUNDER_AUTH_JWKS_URL",
          "resource": "THUNDER_AUTH_RESOURCE",
          "scopes": "THUNDER_AUTH_SCOPES"
        }
      }
    }
  ],
  "skillsPinned": [
    "wireframes",
    "react-webapp",
    "oxygen-ui-design-system",
    "thunder-authentication"
  ]
}
