{
  "name": "expense-api",
  "type": "service",
  "version": "0.1.0",
  "language": "Ballerina",
  "buildpack": "docker",
  "appPath": "expense-api",
  "entrypoint": "deployment/service",
  "exposure": "internet",
  "stories": [
    "F1.1",
    "F1.2",
    "F1.4",
    "F1.5",
    "F1.6",
    "F1.7",
    "F2.1",
    "F2.2",
    "F2.3",
    "F2.4",
    "F3.1",
    "F3.2",
    "F3.3",
    "F4.1",
    "F4.2"
  ],
  "description": "Owns expense claims end to end: creation and edits by the submitting employee, the manager approval queue and decisions, finance's payroll export, and in-app notifications. Does not read or write receipts' content — it only stores the receipt file and the fields the employee confirms.",
  "dependencies": [
    {
      "kind": "platform-resource",
      "name": "expense-db",
      "description": "Stores employees, expense claims and notifications.",
      "resourceType": "postgres-cnpg",
      "wiring": {
        "ref": "employees-submit-0347713b",
        "envBindings": {
          "dbname": "EXPENSE_DB_DBNAME",
          "host": "EXPENSE_DB_HOST",
          "password": "EXPENSE_DB_PASSWORD",
          "port": "EXPENSE_DB_PORT",
          "user": "EXPENSE_DB_USER"
        }
      }
    },
    {
      "kind": "platform-resource",
      "name": "thunder-auth",
      "description": "Verifies the gateway's signed assertion for every protected operation.",
      "resourceType": "thunder-app",
      "wiring": {
        "ref": "employees-submit-98a6d041",
        "envBindings": {
          "client_id": "THUNDER_AUTH_CLIENT_ID",
          "issuer": "THUNDER_AUTH_ISSUER",
          "jwks_url": "THUNDER_AUTH_JWKS_URL",
          "resource": "THUNDER_AUTH_RESOURCE",
          "scopes": "THUNDER_AUTH_SCOPES"
        }
      }
    }
  ],
  "exposesAPI": {
    "auth": "end-user-required"
  },
  "skillsPinned": [
    "openapi-conventions",
    "ballerina",
    "api-management",
    "thunder-authentication"
  ]
}
